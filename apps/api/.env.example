# ==========================================
# 🚀 Cleo Platform — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Server ──
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://cleoplatform.com

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host:5432/cleo_platform?schema=public

# ── JWT Authentication ──
# MUST be different from JWT_RESET_SECRET and at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# Password reset token secret (separate from JWT_SECRET)
JWT_RESET_SECRET=your-separate-reset-secret-minimum-32-characters

# ── Culqi Payment Gateway ──
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
CULQI_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ── Email (SMTP) ──
# Option 1: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option 2: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxx

# Email display settings
EMAIL_FROM_NAME=Cleo Platform
EMAIL_FROM_ADDRESS=noreply@cleoplatform.com

# ── Supabase (Storage & Database) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_STORAGE_BUCKET=product-images

# ── Redis (Optional — for caching & queues) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ──
# Comma-separated allowed origins for production
CORS_ORIGINS=https://cleoplatform.com,https://admin.cleoplatform.com

# ── Logging ──
# Options: error, warn, info, debug
LOG_LEVEL=info
